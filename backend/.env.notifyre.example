# Campaign 1: client care, appointments, billing/insurance, and portal access.
# Staff/workforce, polling and marketing remain outside this transport.
# Store the two secrets in Secret Manager; never commit their real values.
NOTIFYRE_API_TOKEN=
NOTIFYRE_WEBHOOK_SECRET=
NOTIFYRE_BAA_REFERENCE=
# Exact agency ID -> approved Notifyre brand/campaign IDs. No wildcard or
# fallback to a different agency's campaign. Use actual IDs, not "Campaign 1".
# Include the isolated ITSCO demo explicitly if it uses ITSCO's own approval.
NOTIFYRE_CLIENT_CAMPAIGNS_JSON={}
NOTIFYRE_ENABLED=false
# Enable after migration 1642 and campaign/sender verification.

# Notifyre Settings > Developer > API Tokens: create the token used above.
# Settings > Developer > Webhooks: one account-wide endpoint, not one per tenant.
# Subscribe to sms_received, sms_sent, mms_received, fax_received and fax_sent
# when this account receives those channels. Each number must have exactly one
# saved agency owner; payload tenant IDs never select the recipient's agency.
# Endpoint: https://YOUR_API_HOST/api/notifyre/webhook
# Reveal that endpoint's secret and set NOTIFYRE_WEBHOOK_SECRET.
# The existing /api/auricwell-sms/webhook URL uses the same owner routing and
# receipt stores, with its own AURICWELL_NOTIFYRE_WEBHOOK_SECRET during migration.
# Fax is routed only to verified primary lines. MMS receipts are retained for
# authorized carrier review; automatic media download is not implemented.
# Dashboard > 10DLC: provide the actual approved Campaign 1 ID, brand ID,
# linked sending numbers, supported uses, and who handles STOP/START/HELP.
# In each matching app sender registration use provider=notifyre and the exact
# brand/campaign IDs configured for that agency. The old global
# NOTIFYRE_CLIENT_CAMPAIGN_ID does not authorize any agency by itself.
# Vonage remains exclusively for nonclinical staff/workforce and other approved
# nonclinical purposes; client care can never fall back to it.
# keywordOwner=notifyre only when Notifyre sends the registered keyword replies;
# otherwise use application. The app always records STOP locally.
# Do not relink an old campaign without explicitly migrating its opt-outs.
# Scheduling-only intake permission does not authorize billing texts.
# Test with a designated consenting test recipient before enabling production.
