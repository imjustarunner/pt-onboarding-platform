+export const QA_SLUG = 'auricwell-qa-demo';
+export function qaSections(role) {
+  const base=['overview','appointments','clients','providers'];
+  if(role==='provider') return [...base,'documentation'];
+  if(role==='support') return base;
+  if(role==='admin') return [...base,'documentation','billing'];
+  return [];
+}
