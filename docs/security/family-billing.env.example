# Family billing: required; store real values in your secret manager, never Git.
# Generate independent 32-byte random keys (base64) for these two data domains.
FAMILY_BILLING_ENCRYPTION_KEY_BASE64=
FAMILY_BILLING_ENCRYPTION_KEY_ID=v1
# Retain old IDs during rotation, e.g. {"v1":"<previous base64 key>"}.
FAMILY_BILLING_PREVIOUS_KEYS_JSON={}
INTAKE_RESPONSES_ENCRYPTION_KEY_BASE64=
INTAKE_RESPONSES_ENCRYPTION_KEY_ID=v1
INTAKE_RESPONSES_ENCRYPTION_KEYS_JSON={}
# Insurance/identity/document uploads fail closed without Cloud KMS.
DOCUMENTS_KMS_KEY=
# Connected-account card collection and signed webhook verification.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Portal URL used in authenticated billing links (must be HTTPS in production).
FRONTEND_URL=
# PNG generation uses the existing Chromium installation in the backend image.
PUPPETEER_EXECUTABLE_PATH=
# Server gate plus tenant feature_flags.familyBillingAutomationEnabled are required.
# Worker creates drafts and processes signed due installments; it never emails families.
FAMILY_BILLING_AUTOMATION_ENABLED=false
